generator client {
  provider = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoPostulacion {
  postulado
  aceptado
  rechazado
  en_curso
  finalizado
}

enum EstadoTesis {
  propuesta
  desarrollo
  sustentacion
  culminado
}

enum EstadoConvenioEspecifico {
  no_aplica
  pendiente
  en_tramite
  aprobado
  rechazado
}

enum RolNombre {
  admin
  coordinador
  asesor
  estudiante
  empresa
}

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      RolNombre    @unique
  descripcion String?
  usuarios    UsuarioRol[]
}

model Usuario {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  password       String         @map("password_hash")
  nombres        String
  apellidos      String
  dni            String         @unique
  telefono       String?
  activo         Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  roles          UsuarioRol[]
  estudiante     Estudiante?
  asesor         Asesor?
  reportes       Reporte[]
  notificaciones Notificacion[]

  @@map("usuario")
}

model UsuarioRol {
  usuario_id  Int
  rol_id      Int
  asignado_en DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  rol         Rol      @relation(fields: [rol_id], references: [id])

  @@id([usuario_id, rol_id])
  @@map("usuario_rol")
}

model Escuela {
  id          Int          @id @default(autoincrement())
  nombre      String
  facultad    String
  estudiantes Estudiante[]
  asesores    Asesor[]

  @@map("escuela")
}

model Estudiante {
  id                   Int           @id @default(autoincrement())
  usuario_id           Int           @unique
  codigo_universitario String        @unique
  escuela_id           Int
  ciclo                String?
  resolucion_practicas String?
  created_at           DateTime      @default(now())
  usuario              Usuario       @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  escuela              Escuela       @relation(fields: [escuela_id], references: [id])
  postulaciones        Postulacion[]
  tesis                Tesis[]

  @@map("estudiante")
}

model Asesor {
  id                      Int                 @id @default(autoincrement())
  usuario_id              Int                 @unique
  escuela_id              Int
  especialidad            String?
  created_at              DateTime            @default(now())
  usuario                 Usuario             @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  escuela                 Escuela             @relation(fields: [escuela_id], references: [id])
  postulaciones           AsesorPostulacion[]
  postulacionesAcademicas Postulacion[]       @relation("AsesorPostulacionRelation")
  tesisAsesorPrincipal    Tesis[]             @relation("AsesorPrincipal")
  juradoTesis             JuradoTesis[]

  @@map("asesor")
}

model Empresa {
  id              Int              @id @default(autoincrement())
  ruc             String           @unique
  razon_social    String
  direccion       String?
  telefono        String?
  email_contacto  String?
  representante   String?
  convenio_activo Boolean          @default(false)
  created_at      DateTime         @default(now())
  convenios       Convenio[]
  ofertas         OfertaPractica[]

  @@map("empresa")
}

model Convenio {
  id           Int      @id @default(autoincrement())
  empresa_id   Int
  fecha_inicio DateTime @db.Date
  fecha_fin    DateTime @db.Date
  tipo         String
  archivo_pdf  String?
  estado       String   @default("vigente")
  created_at   DateTime @default(now())
  empresa      Empresa  @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@map("convenio")
}

model OfertaPractica {
  id            Int           @id @default(autoincrement())
  empresa_id    Int
  titulo        String
  descripcion   String
  requisitos    String?
  fecha_inicio  DateTime      @db.Date
  fecha_fin     DateTime      @db.Date
  vacantes      Int
  modalidad     String
  estado        String        @default("abierta")
  created_at    DateTime      @default(now())
  empresa       Empresa       @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  postulaciones Postulacion[]

  @@map("oferta_practica")
}

model Postulacion {
  id                           Int                     @id @default(autoincrement())
  oferta_id                    Int
  estudiante_id                Int
  asesor_academico_id          Int?
  fecha_postulacion            DateTime                @default(now()) @db.Date
  estado                       EstadoPostulacion       @default(postulado)
  requiere_convenio_especifico Boolean                 @default(false)
  estado_convenio_especifico   EstadoConvenioEspecifico @default(no_aplica)
  created_at                   DateTime                @default(now())
  oferta                       OfertaPractica          @relation(fields: [oferta_id], references: [id], onDelete: Cascade)
  estudiante                   Estudiante              @relation(fields: [estudiante_id], references: [id], onDelete: Cascade)
  asesor_academico             Asesor?                 @relation("AsesorPostulacionRelation", fields: [asesor_academico_id], references: [id])
  asesorPostulacion            AsesorPostulacion?
  seguimiento                  SeguimientoPractica?

  @@map("postulacion")
}

model AsesorPostulacion {
  id             Int         @id @default(autoincrement())
  asesor_id      Int
  postulacion_id Int         @unique
  asignado_en    DateTime    @default(now())
  asesor         Asesor      @relation(fields: [asesor_id], references: [id])
  postulacion    Postulacion @relation(fields: [postulacion_id], references: [id], onDelete: Cascade)

  @@map("asesor_postulacion")
}

model SeguimientoPractica {
  id                               Int                     @id @default(autoincrement())
  postulacion_id                   Int                     @unique
  horas_cumplidas                  Int                     @default(0)
  horas_totales                    Int                     @default(600)
  solicitud_revision_informe_final Boolean               @default(false)
  informe_estudiante               String?
  informe_asesor                   String?
  evaluacion                       String                  @default("pendiente")
  fecha_evaluacion                 DateTime?               @db.Date
  created_at                       DateTime                @default(now())
  postulacion                      Postulacion             @relation(fields: [postulacion_id], references: [id], onDelete: Cascade)
  reportes_mensuales               ReporteMensualPractica[]

  @@map("seguimiento_practica")
}

model ReporteMensualPractica {
  id               Int                 @id @default(autoincrement())
  seguimiento_id   Int
  anio             Int
  mes              Int
  horas_reportadas Int
  archivo_url      String?
  observaciones    String?
  created_at       DateTime            @default(now())
  seguimiento      SeguimientoPractica @relation(fields: [seguimiento_id], references: [id], onDelete: Cascade)

  @@unique([seguimiento_id, anio, mes])
  @@map("reporte_mensual_practica")
}

model Tesis {
  id                               Int               @id @default(autoincrement())
  titulo                           String
  resumen                          String?
  estudiante_id                    Int
  asesor_principal_id              Int
  estado                           EstadoTesis       @default(propuesta)
  fecha_inicio                     DateTime?         @db.Date
  fecha_sustentacion               DateTime?         @db.Date
  recibo_turnitin_url              String?
  recibo_turnitin_cargado_en       DateTime?
  similitud_turnitin               Decimal?          @db.Decimal(5, 2)
  similitud_registrada_en          DateTime?
  similitud_registrada_por_asesor_id Int?
  updated_at                       DateTime          @updatedAt
  created_at                       DateTime          @default(now())
  estudiante                       Estudiante        @relation(fields: [estudiante_id], references: [id], onDelete: Cascade)
  asesor_principal                 Asesor            @relation("AsesorPrincipal", fields: [asesor_principal_id], references: [id])
  jurados                          JuradoTesis[]
  avances                          AvanceTesis[]
  acta                             ActaSustentacion?

  @@map("tesis")
}

model JuradoTesis {
  id        Int    @id @default(autoincrement())
  tesis_id  Int
  asesor_id Int
  rol       String
  tesis     Tesis  @relation(fields: [tesis_id], references: [id], onDelete: Cascade)
  asesor    Asesor @relation(fields: [asesor_id], references: [id])

  @@unique([tesis_id, rol])
  @@map("jurado_tesis")
}

model AvanceTesis {
  id            Int      @id @default(autoincrement())
  tesis_id      Int
  tipo          String
  descripcion   String
  fecha_entrega DateTime @db.Date
  estado        String   @default("entregado")
  observaciones String?
  created_at    DateTime @default(now())
  tesis         Tesis    @relation(fields: [tesis_id], references: [id], onDelete: Cascade)

  @@map("avance_tesis")
}

model ActaSustentacion {
  id                  Int      @id @default(autoincrement())
  tesis_id            Int      @unique
  fecha               DateTime @db.Date
  lugar               String?
  nota_final          Float?
  archivo_acta_pdf    String?
  calificaciones_jurado Json?
  created_at          DateTime @default(now())
  tesis               Tesis    @relation(fields: [tesis_id], references: [id], onDelete: Cascade)

  @@map("acta_sustentacion")
}

model Notificacion {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  titulo     String
  mensaje    String
  leida      Boolean  @default(false)
  metadata   Json?
  created_at DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("notificacion")
}

model Reporte {
  id               Int      @id @default(autoincrement())
  tipo             String
  parametros       Json?
  archivo_generado Bytes?
  generado_en      DateTime @default(now())
  generado_por     Int?
  usuario          Usuario? @relation(fields: [generado_por], references: [id])

  @@map("reporte")
}